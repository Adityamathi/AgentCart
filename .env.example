# ---------------------------------------------------------------------------
# AgentCart environment
# Copy to .env (repo root) or server/.env and fill in what you have.
# The app runs without PayPal or AI keys: the agent falls back to its local
# planner and checkout stays in a "configuration required" state.
# ---------------------------------------------------------------------------

# Server
PORT=4000
NODE_ENV=development
APP_ORIGIN=http://localhost:5173

# Session signing / hashing secret. Any long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Database
# Leave DATABASE_URL empty to use the embedded SQLite file at server/data/agentcart.db.
# Set it to a Supabase/Postgres connection string to use Postgres instead.
# ---------------------------------------------------------------------------
DATABASE_URL=
SQLITE_PATH=

# ---------------------------------------------------------------------------
# AI provider (tool calling). One of: auto | gemini | groq | openai | heuristic
# "auto" uses Gemini if a key is present, then OpenAI, then the local planner.
# ---------------------------------------------------------------------------
AI_PROVIDER=auto
AI_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Groq is OpenAI-compatible and makes a fast fallback when Gemini is unavailable.
# Get a key at https://console.groq.com/keys. Any provider with a key joins the
# chain, tried in this order: gemini -> groq -> openai -> local planner.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# ---------------------------------------------------------------------------
# PayPal Orders API v2 (sandbox)
# Create an app at https://developer.paypal.com/dashboard/applications/sandbox
# ---------------------------------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD

# ---------------------------------------------------------------------------
# Cart totals (the server is the only authority for money)
# ---------------------------------------------------------------------------
SHIPPING_FLAT_CENTS=0
TAX_RATE_BPS=0

# Seed account created by `npm run db:seed`
DEMO_EMAIL=demo@agentcart.dev
DEMO_PASSWORD=demo12345
